# Port server API
PORT=3000

# Host (0.0.0.0 = semua interface, berguna untuk akses dari perangkat lain)
HOST=0.0.0.0

# Jalur yt-dlp (default: ./bin/yt-dlp.exe)
# YTDLP_PATH=D:\mini snaptik\backend\bin\yt-dlp.exe

# Jalur file cookies dari login TikTok (opsional, untuk video private/premium)
# Format: Netscape cookies.txt. Export dari browser extension.
# COOKIES_PATH=D:\mini snaptik\backend\cookies.txt

# Mode ekstraksi video:
#   auto  = coba yt-dlp dulu, kalau gagal fallback ke TikWM (default)
#   tikwm = SELALU pakai TikWM API (tanpa yt-dlp) - direkomendasikan untuk Render/VPS
# EXTRACTOR=tikwm

# Endpoint TikWM API untuk fallback (opsional, default publik)
# TIKWM_API=https://www.tikwm.com/api/
